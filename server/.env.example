# Copy this file to .env and fill in your values

PORT=3000

# PostgreSQL connection (local Postgres, or your Azure Postgres later)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trackr_study

# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Stronger model for teaching and chat, cheaper model for quizzes and topic detection
MODEL_TEACH=claude-sonnet-5-5
MODEL_FAST=claude-haiku-4-5-20251001

# Set to true to try the app without an API key (returns sample AI content, costs nothing)
MOCK_AI=false

# Where uploaded PDFs are stored (swap for Azure Blob Storage later)
UPLOAD_DIR=uploads
